# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Connection string direta do Postgres do Supabase.
# Painel do Supabase -> Project Settings -> Database -> Connection string (URI)
# Formato: postgresql://postgres:SENHA@db.<project_ref>.supabase.co:5432/postgres
CONNECTION_STRING="postgresql://postgres:SENHA@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# Mesmos valores já usados no frontend (uems_labs/.env) — não são secretos,
# são as chaves públicas usadas para validar o token de login do Supabase Auth.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
