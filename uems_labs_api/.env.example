# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Connection string do Postgres do Supabase via Session Pooler (IPv4).
# A conexao direta (db.<project_ref>.supabase.co) e IPv6-only e pode nao
# funcionar na sua rede -- use sempre o pooler.
# Painel do Supabase -> Project Settings -> Database -> Connect -> Session pooler
# Formato: postgresql://postgres.<project_ref>:SENHA@aws-X-<regiao>.pooler.supabase.com:5432/postgres
CONNECTION_STRING="postgresql://postgres.xxxxxxxxxxxx:SENHA@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Mesmos valores já usados no frontend (uems_labs/.env) — não são secretos,
# são as chaves públicas usadas para validar o token de login do Supabase Auth.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
